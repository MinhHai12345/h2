# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# New H2-Football database. Do not point this at the legacy MMO schema.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=h2_football
DB_USERNAME=h2football
DB_PASSWORD=change-me

# SofaScore provider
SOFASCORE_ENABLED=false
SOFASCORE_WEB_URL=https://www.sofascore.com
SOFASCORE_REGION=VN
SOFASCORE_HEADLESS=true
SOFASCORE_BROWSER_CHANNEL=chrome
SOFASCORE_PROFILE_DIRECTORY=.runtime/sofascore-profile

# SofaScore scheduled ingestion jobs
SOFASCORE_LEAGUE_CATALOGUE_JOB_ENABLED=false
SOFASCORE_LEAGUE_CATALOGUE_JOB_CRON=0 0 2 * * ?
SOFASCORE_LEAGUE_CATALOGUE_JOB_RUN_ON_STARTUP=false
SOFASCORE_INGESTION_JOB_ENABLED=false
SOFASCORE_INGESTION_JOB_CRON=0 15 2 * * ?
SOFASCORE_INGESTION_JOB_RUN_ON_STARTUP=false
SOFASCORE_MATCH_DETAILS_ENABLED=false
SOFASCORE_MATCH_DETAILS_RETRY_ATTEMPTS=3
SOFASCORE_MATCH_DETAILS_RETRY_DELAY_MILLIS=1000

# Other providers (not implemented yet)
UNDERSTAT_ENABLED=false
FOOTBALL_DATA_ENABLED=false
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_UK_ENABLED=false

# Operations API protection
INGESTION_ADMIN_API_KEY=replace-with-a-long-random-secret
APP_TIME_ZONE=UTC
